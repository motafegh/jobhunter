# Copy this file to jobhunter.toml and adjust local values.
[jobhunter]
data_dir = "data"
evidence_dir = "data/evidence"
database_path = "data/jobhunter.sqlite3"

lm_studio_base_url = "http://127.0.0.1:1234/v1"
# Use an exact identifier returned by the LM Studio models endpoint.
# lm_studio_model = "your-model-identifier"

inference_timeout_seconds = 30.0
inference_max_retries = 1

# Public Jobinja HTTP controls.
jobinja_user_agent = "JobHunter/0.1 (local personal career research)"
jobinja_request_timeout_seconds = 30.0
jobinja_request_delay_seconds = 1.0

# Search vocabulary is loaded from src/jobhunter/data/search_catalog.toml.
# To replace the built-in vocabulary without editing Python code, point to a
# complete catalog using the schema documented in docs/SEARCH_CONFIGURATION.md.
# jobinja_search_catalog_path = "my-search-catalog.toml"

# Search-planning controls. The request budget is global across the selected
# searches, so a large vocabulary cannot trigger unbounded acquisition.
jobinja_search_request_budget = 40
jobinja_max_expanded_searches = 40
jobinja_default_keyword_max_pages = 1

# Recommended bilingual profile for AI/ML, LLM apps, Python/data, defensive
# security, AI security, and network/platform roles.
jobinja_search_profiles = ["ai-security-python"]
jobinja_search_packs = []
jobinja_excluded_terms = []

# Acquisition-only daily sync controls.
jobinja_sync_missing_limit = 10
jobinja_sync_refresh_limit = 5
jobinja_refresh_after_hours = 24.0

# Separate derived English corpus. LM Studio is the local-first default.
# Native-English jobs are copied into the English projection without a model call.
translation_enabled = false
translation_auto_after_sync = false
translation_provider = "lm-studio"
translation_target_language = "en"
translation_batch_limit = 20
translation_timeout_seconds = 30.0
translation_max_retries = 1

# Translation can reuse lm_studio_model. A dedicated translation model may be
# selected independently when desired. If neither is configured, JobHunter will
# auto-select only when exactly one model is visible from LM Studio.
# translation_lm_studio_model = "your-translation-model-identifier"
translation_lm_studio_max_tokens = 4096
translation_lm_studio_character_target = 6000

# Google Cloud remains an optional external translation provider:
# translation_provider = "google-cloud"
# google_translation_model = "nmt"
# export JOBHUNTER_GOOGLE_TRANSLATION_API_KEY='...'

# Add customized Persian and English searches without changing Python code.
# [[jobhunter.jobinja_keyword_groups]]
# name = "My highest-priority hybrid roles"
# terms = [
#   "مهندس امنیت هوش مصنوعی",
#   "AI Security Engineer",
#   "Python Security Automation",
#   "مهندس تشخیص",
#   "Detection Engineer",
# ]
# enabled = true
# max_pages = 1

# Raw Jobinja result URLs remain supported for filters that a keyword alone
# cannot represent, such as a specific location or Jobinja-owned filter.
# [[jobhunter.jobinja_searches]]
# name = "Tehran remote AI roles"
# url = "https://jobinja.ir/jobs?filters%5Bkeywords%5D%5B0%5D=..."
# enabled = true
# max_pages = 2

log_level = "INFO"
