# Optional environment overrides. Do not commit the real .env file.
JOBHUNTER_CONFIG=jobhunter.toml
JOBHUNTER_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# JOBHUNTER_LM_STUDIO_MODEL=your-model-identifier
# JOBHUNTER_LM_STUDIO_API_TOKEN=your-local-token
JOBHUNTER_INFERENCE_TIMEOUT_SECONDS=30
JOBHUNTER_INFERENCE_MAX_RETRIES=1
JOBHUNTER_JOBINJA_USER_AGENT="JobHunter/0.1 (local personal career research)"
JOBHUNTER_JOBINJA_REQUEST_TIMEOUT_SECONDS=30
JOBHUNTER_JOBINJA_REQUEST_DELAY_SECONDS=1
JOBHUNTER_JOBINJA_SEARCH_REQUEST_BUDGET=40
JOBHUNTER_JOBINJA_MAX_EXPANDED_SEARCHES=100
JOBHUNTER_JOBINJA_SYNC_MISSING_LIMIT=10
JOBHUNTER_JOBINJA_SYNC_REFRESH_LIMIT=5
JOBHUNTER_JOBINJA_REFRESH_AFTER_HOURS=24
JOBHUNTER_LOG_LEVEL=INFO
